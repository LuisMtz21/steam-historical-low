{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "steam-historical-low",
  "main": "src/index.js",
  "compatibility_date": "2026-11-21",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "ea12ecc249ca47e98ae5c414aac2e3af"
    }
  ],
  "triggers": {
    "crons": ["0 14 * * *", "5 18 * * *"]
  }
}
